# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weekly_reports_db
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# AI Chat Assistant (optional - Good to Have feature)
# Leave blank until you purchase a key. The AI endpoints will respond
# with a clear "not configured" message until this is set.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
